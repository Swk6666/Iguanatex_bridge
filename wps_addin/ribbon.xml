<?xml version="1.0" encoding="UTF-8"?>
<customUI xmlns="http://schemas.microsoft.com/office/2006/01/customui" onLoad="OnAddinLoad">
  <ribbon startFromScratch="false">
    <tabs>
      <tab id="IguanaTexBridgeTab" label="IguanaTex">
        <group id="IguanaTexFormulas" label="LaTeX 公式">
          <button id="IguanaNew" label="新建公式" size="large" imageMso="FileNew" onAction="OnNewFormula" screentip="在当前幻灯片插入 LaTeX 公式"/>
          <button id="IguanaRecognize" label="图片转公式" size="large" imageMso="PictureInsert" onAction="OnRecognizeImage" screentip="识别选中的图片并生成可编辑公式；图片将发送至 OpenAI"/>
          <button id="IguanaEdit" label="编辑选中公式" size="large" imageMso="FileSaveAs" onAction="OnEditFormula" screentip="读取选中图片内的 IguanaTex 源码"/>
        </group>
        <group id="IguanaTexCompatibility" label="跨平台">
          <button id="IguanaProtect" label="检查与同步源码" size="large" imageMso="FileCompatibilityChecker" onAction="OnProtectFormulas"/>
          <button id="IguanaHelp" label="环境与帮助" size="large" imageMso="Help" onAction="OnBridgeHelp"/>
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>
