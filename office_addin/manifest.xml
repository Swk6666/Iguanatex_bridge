        <bt:Image id="Status.Icon32" DefaultValue="https://localhost:17864/office/icons/status-32.png"/>
        <bt:Image id="Status.Icon80" DefaultValue="https://localhost:17864/office/icons/status-80.png"/>
        <bt:Image id="Cancel.Icon16" DefaultValue="https://localhost:17864/office/icons/cancel-16.png"/>
