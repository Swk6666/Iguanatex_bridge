      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="New.Description" DefaultValue="新建 LaTeX 公式，预览后插入当前幻灯片。"/>
        <bt:String id="Picture.Description" DefaultValue="将同一页选中的一张或多张图片发送给 OpenAI 逐张识别并转换为可编辑公式。"/>
        <bt:String id="Edit.Description" DefaultValue="读取所选公式的源码、引擎和字号，修改后更新。"/>
        <bt:String id="Status.Description" DefaultValue="查看 AI 请求的进度和最近结果。"/>
        <bt:String id="Cancel.Description" DefaultValue="停止当前 AI 请求；已发送的请求可能产生用量。"/>
        <bt:String id="Settings.Description" DefaultValue="设置图片转公式时的字号、颜色和对齐方式。"/>
        <bt:String id="Draft.Description" DefaultValue="选中转换失败的原图片，恢复已保存的源码草稿。"/>
        <bt:String id="Protect.Description" DefaultValue="检查当前演示文稿的公式并同步源码备份。"/>
        <bt:String id="Help.Description" DefaultValue="查看使用方式、PowerPoint 兼容性和本机 LaTeX 环境。"/>
      </bt:LongStrings>
