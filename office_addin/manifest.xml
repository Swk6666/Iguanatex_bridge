<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="TaskPaneApp">
  <Id>462f0768-b34e-45b1-9e1b-f6e2474c71b9</Id>
  <Version>1.0.0.6</Version>
  <ProviderName>IguanaTex Bridge</ProviderName>
  <DefaultLocale>zh-CN</DefaultLocale>
  <DisplayName DefaultValue="IguanaTex Bridge"/>
  <Description DefaultValue="LaTeX 公式编辑与 OpenAI API 文字与图片对话，适用于 Mac 和 Windows PowerPoint。"/>
  <IconUrl DefaultValue="https://localhost:17864/office/icon.png"/>
  <SupportUrl DefaultValue="https://github.com/Swk6666/Iguanatex_bridge"/>
  <AppDomains><AppDomain>https://localhost:17864</AppDomain></AppDomains>
  <Hosts><Host Name="Presentation"/></Hosts>
  <Requirements><Sets DefaultMinVersion="1.1"><Set Name="PowerPointApi" MinVersion="1.1"/><Set Name="SharedRuntime" MinVersion="1.1"/></Sets></Requirements>
  <DefaultSettings><SourceLocation DefaultValue="https://localhost:17864/office/taskpane.html?runtime=1"/></DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
   xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
   xsi:type="VersionOverridesV1_0">
    <Requirements><bt:Sets DefaultMinVersion="1.1"><bt:Set Name="AddinCommands" MinVersion="1.1"/></bt:Sets></Requirements>
    <Hosts><Host xsi:type="Presentation"><Runtimes><Runtime resid="Runtime.Url" lifetime="long"/></Runtimes><DesktopFormFactor><FunctionFile resid="Runtime.Url"/><ExtensionPoint xsi:type="PrimaryCommandSurface">
      <CustomTab id="IgBridge.Tab">
        <Group id="IgBridge.Formulas">
          <Label resid="Formulas.Group"/>
          <Icon>
            <bt:Image size="16" resid="New.Icon16"/>
            <bt:Image size="32" resid="New.Icon32"/>
            <bt:Image size="80" resid="New.Icon80"/>
          </Icon>
          <Control xsi:type="Button" id="IgBridge.New">
            <Label resid="New.Label"/>
            <Supertip><Title resid="New.Label"/><Description resid="New.Description"/></Supertip>
            <Icon>
              <bt:Image size="16" resid="New.Icon16"/>
              <bt:Image size="32" resid="New.Icon32"/>
              <bt:Image size="80" resid="New.Icon80"/>
            </Icon>
            <Action xsi:type="ExecuteFunction"><FunctionName>igBridgeNew</FunctionName></Action>
          </Control>
          <Control xsi:type="Button" id="IgBridge.Picture">
            <Label resid="Picture.Label"/>
            <Supertip><Title resid="Picture.Label"/><Description resid="Picture.Description"/></Supertip>
            <Icon>
              <bt:Image size="16" resid="Picture.Icon16"/>
              <bt:Image size="32" resid="Picture.Icon32"/>
              <bt:Image size="80" resid="Picture.Icon80"/>
            </Icon>
            <Action xsi:type="ExecuteFunction"><FunctionName>igBridgePicture</FunctionName></Action>
          </Control>
          <Control xsi:type="Button" id="IgBridge.Edit">
            <Label resid="Edit.Label"/>
            <Supertip><Title resid="Edit.Label"/><Description resid="Edit.Description"/></Supertip>
            <Icon>
              <bt:Image size="16" resid="Edit.Icon16"/>
              <bt:Image size="32" resid="Edit.Icon32"/>
              <bt:Image size="80" resid="Edit.Icon80"/>
            </Icon>
            <Action xsi:type="ExecuteFunction"><FunctionName>igBridgeEdit</FunctionName></Action>
          </Control>
        </Group>
        <Group id="IgBridge.Automation">
          <Label resid="Automation.Group"/>
          <Icon>
            <bt:Image size="16" resid="Status.Icon16"/>
            <bt:Image size="32" resid="Status.Icon32"/>
            <bt:Image size="80" resid="Status.Icon80"/>
          </Icon>
          <Control xsi:type="Button" id="IgBridge.Status">
            <Label resid="Status.Label"/>
            <Supertip><Title resid="Status.Label"/><Description resid="Status.Description"/></Supertip>
            <Icon>
              <bt:Image size="16" resid="Status.Icon16"/>
              <bt:Image size="32" resid="Status.Icon32"/>
              <bt:Image size="80" resid="Status.Icon80"/>
            </Icon>
            <Action xsi:type="ExecuteFunction"><FunctionName>igBridgeStatus</FunctionName></Action>
          </Control>
          <Control xsi:type="Button" id="IgBridge.Cancel">
            <Label resid="Cancel.Label"/>
            <Supertip><Title resid="Cancel.Label"/><Description resid="Cancel.Description"/></Supertip>
            <Icon>
              <bt:Image size="16" resid="Cancel.Icon16"/>
              <bt:Image size="32" resid="Cancel.Icon32"/>
              <bt:Image size="80" resid="Cancel.Icon80"/>
            </Icon>
            <Action xsi:type="ExecuteFunction"><FunctionName>igBridgeCancel</FunctionName></Action>
          </Control>
          <Control xsi:type="Button" id="IgBridge.Settings">
            <Label resid="Settings.Label"/>
            <Supertip><Title resid="Settings.Label"/><Description resid="Settings.Description"/></Supertip>
            <Icon>
              <bt:Image size="16" resid="Settings.Icon16"/>
              <bt:Image size="32" resid="Settings.Icon32"/>
              <bt:Image size="80" resid="Settings.Icon80"/>
            </Icon>
            <Action xsi:type="ExecuteFunction"><FunctionName>igBridgeSettings</FunctionName></Action>
          </Control>
          <Control xsi:type="Button" id="IgBridge.Draft">
            <Label resid="Draft.Label"/>
            <Supertip><Title resid="Draft.Label"/><Description resid="Draft.Description"/></Supertip>
            <Icon>
              <bt:Image size="16" resid="Draft.Icon16"/>
              <bt:Image size="32" resid="Draft.Icon32"/>
              <bt:Image size="80" resid="Draft.Icon80"/>
            </Icon>
            <Action xsi:type="ExecuteFunction"><FunctionName>igBridgeDraft</FunctionName></Action>
          </Control>
        </Group>
        <Group id="IgBridge.Compatibility">
          <Label resid="Compatibility.Group"/>
          <Icon>
            <bt:Image size="16" resid="Protect.Icon16"/>
            <bt:Image size="32" resid="Protect.Icon32"/>
            <bt:Image size="80" resid="Protect.Icon80"/>
          </Icon>
          <Control xsi:type="Button" id="IgBridge.Protect">
            <Label resid="Protect.Label"/>
            <Supertip><Title resid="Protect.Label"/><Description resid="Protect.Description"/></Supertip>
            <Icon>
              <bt:Image size="16" resid="Protect.Icon16"/>
              <bt:Image size="32" resid="Protect.Icon32"/>
              <bt:Image size="80" resid="Protect.Icon80"/>
            </Icon>
            <Action xsi:type="ExecuteFunction"><FunctionName>igBridgeProtect</FunctionName></Action>
          </Control>
          <Control xsi:type="Button" id="IgBridge.Help">
            <Label resid="Help.Label"/>
            <Supertip><Title resid="Help.Label"/><Description resid="Help.Description"/></Supertip>
            <Icon>
              <bt:Image size="16" resid="Help.Icon16"/>
              <bt:Image size="32" resid="Help.Icon32"/>
              <bt:Image size="80" resid="Help.Icon80"/>
            </Icon>
            <Action xsi:type="ExecuteFunction"><FunctionName>igBridgeHelp</FunctionName></Action>
          </Control>
        </Group>
        <Label resid="Tab.Label"/>
      </CustomTab>
    </ExtensionPoint></DesktopFormFactor></Host></Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="New.Icon16" DefaultValue="https://localhost:17864/office/icons/new-16.png"/>
        <bt:Image id="New.Icon32" DefaultValue="https://localhost:17864/office/icons/new-32.png"/>
        <bt:Image id="New.Icon80" DefaultValue="https://localhost:17864/office/icons/new-80.png"/>
