        <bt:Image id="Protect.Icon16" DefaultValue="https://localhost:17864/office/icons/protect-16.png"/>
        <bt:Image id="Protect.Icon32" DefaultValue="https://localhost:17864/office/icons/protect-32.png"/>
        <bt:Image id="Protect.Icon80" DefaultValue="https://localhost:17864/office/icons/protect-80.png"/>
        <bt:Image id="Help.Icon16" DefaultValue="https://localhost:17864/office/icons/help-16.png"/>
        <bt:Image id="Help.Icon32" DefaultValue="https://localhost:17864/office/icons/help-32.png"/>
        <bt:Image id="Help.Icon80" DefaultValue="https://localhost:17864/office/icons/help-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Runtime.Url" DefaultValue="https://localhost:17864/office/taskpane.html?runtime=1"/>
        <bt:Url id="New.Url" DefaultValue="https://localhost:17864/office/taskpane.html?mode=new"/>
        <bt:Url id="Picture.Url" DefaultValue="https://localhost:17864/office/batch.html"/>
        <bt:Url id="Edit.Url" DefaultValue="https://localhost:17864/office/taskpane.html?mode=edit"/>
        <bt:Url id="Status.Url" DefaultValue="https://localhost:17864/office/utility.html?mode=status"/>
        <bt:Url id="Cancel.Url" DefaultValue="https://localhost:17864/office/utility.html?mode=cancel"/>
        <bt:Url id="Settings.Url" DefaultValue="https://localhost:17864/office/utility.html?mode=settings"/>
        <bt:Url id="Draft.Url" DefaultValue="https://localhost:17864/office/taskpane.html?mode=draft"/>
        <bt:Url id="Protect.Url" DefaultValue="https://localhost:17864/office/utility.html?mode=protect"/>
        <bt:Url id="Help.Url" DefaultValue="https://localhost:17864/office/utility.html?mode=help"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="Tab.Label" DefaultValue="IguanaTex Bridge"/>
        <bt:String id="Formulas.Group" DefaultValue="LaTeX 公式"/>
        <bt:String id="Automation.Group" DefaultValue="转换管理"/>
        <bt:String id="Compatibility.Group" DefaultValue="跨平台"/>
        <bt:String id="New.Label" DefaultValue="新建公式"/>
        <bt:String id="Picture.Label" DefaultValue="图片转公式"/>
        <bt:String id="Edit.Label" DefaultValue="编辑选中公式"/>
        <bt:String id="Status.Label" DefaultValue="转换状态"/>
        <bt:String id="Cancel.Label" DefaultValue="取消转换"/>
        <bt:String id="Settings.Label" DefaultValue="转换设置"/>
        <bt:String id="Draft.Label" DefaultValue="编辑失败草稿"/>
